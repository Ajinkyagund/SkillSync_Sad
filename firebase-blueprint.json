{
  "entities": {
    "User": {
      "title": "User",
      "description": "Private user data (PII).",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "credits": { "type": "number" },
        "role": { "type": "string", "enum": ["student", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "credits", "role", "createdAt"]
    },
    "Profile": {
      "title": "Profile",
      "description": "Public user profile information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "photoURL": { "type": "string" },
        "bio": { "type": "string" },
        "skillsMastered": { "type": "array", "items": { "type": "string" } },
        "skillsWanted": { "type": "array", "items": { "type": "string" } },
        "friends": { "type": "array", "items": { "type": "string" } },
        "ratingAverage": { "type": "number" },
        "ratingCount": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name"]
    },
    "Session": {
      "title": "Session",
      "description": "A 1-on-1 skill exchange session.",
      "type": "object",
      "properties": {
        "mentorId": { "type": "string" },
        "learnerId": { "type": "string" },
        "skill": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "scheduled", "completed", "cancelled"] },
        "scheduledAt": { "type": "string", "format": "date-time" },
        "duration": { "type": "number", "description": "Duration in hours" },
        "proofOfWork": { "type": "string", "description": "URL or description of the project file" },
        "review": { "type": "string" },
        "rating": { "type": "number" },
        "isLive": { "type": "boolean", "description": "Whether the session is currently live" },
        "whiteboardData": { "type": "string", "description": "JSON string of whiteboard lines" },
        "notesData": { "type": "string", "description": "Collaborative notes content" },
        "chatData": { "type": "array", "items": { "type": "object" }, "description": "Session chat history" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["mentorId", "learnerId", "skill", "status", "duration", "createdAt"]
    },
    "SprintGroup": {
      "title": "SprintGroup",
      "description": "An AI-formed temporary micro-community.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "goal": { "type": "string" },
        "members": { "type": "array", "items": { "type": "string" } },
        "aiSummary": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "goal", "members", "createdAt"]
    },
    "Message": {
      "title": "Message",
      "description": "A message between users (includes Ghost-Teaching).",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "receiverId": { "type": "string" },
        "content": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "ghost-teaching-video"] },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined"], "description": "For Ghost-Teaching requests" },
        "skill": { "type": "string", "description": "The skill being taught" },
        "videoUrl": { "type": "string", "description": "URL for Ghost-Teaching" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "receiverId", "content", "type", "timestamp"]
    },
    "Meeting": {
      "title": "Meeting",
      "description": "A live meeting with restricted access.",
      "type": "object",
      "properties": {
        "hostId": { "type": "string" },
        "invitedUsers": { "type": "array", "items": { "type": "string" }, "description": "List of UIDs invited to the meeting" },
        "status": { "type": "string", "enum": ["active", "ended"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["hostId", "invitedUsers", "status", "createdAt"]
    },
    "FriendRequest": {
      "title": "FriendRequest",
      "description": "A request to connect as friends.",
      "type": "object",
      "properties": {
        "from": { "type": "string", "description": "Sender UID" },
        "to": { "type": "string", "description": "Receiver UID" },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined"] },
        "senderName": { "type": "string" },
        "senderPhoto": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["from", "to", "status", "senderName", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Alerts for sessions, matches, and updates.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string", "enum": ["session_reminder", "match", "announcement", "system"] },
        "link": { "type": "string", "description": "Optional link to navigate to" },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "message", "type", "isRead", "createdAt"]
    },
    "SharedFile": {
      "title": "SharedFile",
      "description": "Notes, PDFs, and other shared documents.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "targetId": { "type": "string", "description": "ID of the Session or SprintGroup it belongs to" },
        "targetType": { "type": "string", "enum": ["session", "sprintGroup", "profile"] },
        "name": { "type": "string" },
        "url": { "type": "string" },
        "type": { "type": "string", "description": "MIME type or file extension" },
        "size": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "targetId", "targetType", "name", "url", "createdAt"]
    },
    "Recommendation": {
      "title": "Recommendation",
      "description": "AI-generated skill recommendations.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "skills": { "type": "array", "items": { "type": "string" } },
        "reasoning": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "skills", "reasoning", "createdAt"]
    },
    "Project": {
      "title": "Project",
      "description": "A project that users can shadow.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "ownerId": { "type": "string" },
        "shadowers": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["active", "completed", "archived"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description", "ownerId", "status", "createdAt"]
    },
    "FlashCardDeck": {
      "title": "FlashCardDeck",
      "description": "A collection of flashcards for a skill.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "skill": { "type": "string" },
        "ownerId": { "type": "string" },
        "isPublic": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "skill", "ownerId", "isPublic", "createdAt"]
    },
    "FlashCard": {
      "title": "FlashCard",
      "description": "An individual flashcard.",
      "type": "object",
      "properties": {
        "deckId": { "type": "string" },
        "front": { "type": "string" },
        "back": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["deckId", "front", "back", "createdAt"]
    },
    "Review": {
      "title": "Review",
      "description": "A peer review for a user.",
      "type": "object",
      "properties": {
        "reviewerId": { "type": "string" },
        "revieweeId": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "sessionId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["reviewerId", "revieweeId", "rating", "comment", "createdAt"]
    },
    "CareerPath": {
      "title": "CareerPath",
      "description": "AI-suggested career paths.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "suggestedPaths": { "type": "array", "items": { "type": "object" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "suggestedPaths", "createdAt"]
    },
    "Reward": {
      "title": "Reward",
      "description": "A reward that can be redeemed with credits.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "cost": { "type": "number" },
        "provider": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description", "cost", "provider", "createdAt"]
    },
    "Redemption": {
      "title": "Redemption",
      "description": "A record of a reward redemption.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "rewardId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "fulfilled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "rewardId", "status", "createdAt"]
    },
    "Hackathon": {
      "title": "Hackathon",
      "description": "A hackathon event.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "problemStatement": { "type": "string" },
        "startDate": { "type": "string", "format": "date-time" },
        "endDate": { "type": "string", "format": "date-time" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["upcoming", "active", "completed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description", "problemStatement", "startDate", "endDate", "status", "createdAt"]
    },
    "HackathonTeam": {
      "title": "HackathonTeam",
      "description": "A team formed for a hackathon.",
      "type": "object",
      "properties": {
        "hackathonId": { "type": "string" },
        "name": { "type": "string" },
        "members": { "type": "array", "items": { "type": "string" } },
        "expertise": { "type": "array", "items": { "type": "string" } },
        "aiReasoning": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["hackathonId", "name", "members", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Private user data and ledgers."
    },
    "/profiles/{userId}": {
      "schema": { "$ref": "#/entities/Profile" },
      "description": "Public user profiles."
    },
    "/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/Session" },
      "description": "Skill exchange sessions."
    },
    "/sprintGroups/{groupId}": {
      "schema": { "$ref": "#/entities/SprintGroup" },
      "description": "AI-generated study squads."
    },
    "/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Direct messages and ghost-teaching exchanges."
    },
    "/meetings/{meetingId}": {
      "schema": { "$ref": "#/entities/Meeting" },
      "description": "Restricted live meetings."
    },
    "/friendRequests/{requestId}": {
      "schema": { "$ref": "#/entities/FriendRequest" },
      "description": "Friend requests between users."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "User notifications."
    },
    "/sharedFiles/{fileId}": {
      "schema": { "$ref": "#/entities/SharedFile" },
      "description": "Shared documents and notes."
    },
    "/recommendations/{recommendationId}": {
      "schema": { "$ref": "#/entities/Recommendation" },
      "description": "AI skill recommendations."
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Projects for shadowing."
    },
    "/flashCardDecks/{deckId}": {
      "schema": { "$ref": "#/entities/FlashCardDeck" },
      "description": "Flashcard collections."
    },
    "/flashCards/{cardId}": {
      "schema": { "$ref": "#/entities/FlashCard" },
      "description": "Individual flashcards."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Peer reviews and ratings."
    },
    "/careerPaths/{pathId}": {
      "schema": { "$ref": "#/entities/CareerPath" },
      "description": "AI career path recommendations."
    },
    "/rewards/{rewardId}": {
      "schema": { "$ref": "#/entities/Reward" },
      "description": "Redeemable rewards."
    },
    "/redemptions/{redemptionId}": {
      "schema": { "$ref": "#/entities/Redemption" },
      "description": "Reward redemption records."
    },
    "/hackathons/{hackathonId}": {
      "schema": { "$ref": "#/entities/Hackathon" },
      "description": "Hackathon events."
    },
    "/hackathonTeams/{teamId}": {
      "schema": { "$ref": "#/entities/HackathonTeam" },
      "description": "Hackathon teams."
    }
  }
}
